# Firebase config (copy to web/.env.local)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true for local emulator development
VITE_USE_FIREBASE_EMULATORS=false

# Mock calendar extraction for local emulator e2e (no Google API key needed)
VITE_MOCK_CALENDAR_EXTRACTION=false

# Calendar OCR runs in Cloud Functions with GOOGLE_API_KEY (Firebase secret).
# Set the secret once:
#   firebase functions:secrets:set GOOGLE_API_KEY
