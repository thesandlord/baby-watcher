rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userHousehold() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId;
    }

    function inHousehold(householdId) {
      return signedIn() && userHousehold() == householdId;
    }

    function isJoiningHousehold(householdId) {
      return signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.inviteCode == resource.data.inviteCode;
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        isSelf(userId) ||
        resource.data.householdId == userHousehold()
      );
      allow create, update: if isSelf(userId);
    }

    match /households/{householdId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 1;
      allow update: if inHousehold(householdId) || isJoiningHousehold(householdId);

      match /availability/{docId} {
        allow read: if inHousehold(householdId);
        allow create, update: if inHousehold(householdId)
          && docId == request.resource.data.date + '_' + request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.date is string;
        allow delete: if inHousehold(householdId)
          && docId == resource.data.date + '_' + request.auth.uid
          && resource.data.userId == request.auth.uid;
      }

      match /schedules/{date} {
        allow read: if inHousehold(householdId);
        allow create, update: if inHousehold(householdId);
        allow delete: if false;
      }
    }
  }
}
