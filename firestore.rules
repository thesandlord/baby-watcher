rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userHousehold() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'watcher');
    }

    function inHousehold(householdId) {
      return signedIn() && userHousehold() == householdId;
    }

    function isWatcher(householdId) {
      return inHousehold(householdId) && userRole() != 'viewer';
    }

    function isJoiningHousehold() {
      return signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.inviteCode == resource.data.inviteCode;
    }

    function memberInHousehold(memberId, householdId) {
      return get(/databases/$(database)/documents/users/$(memberId)).data.householdId == householdId;
    }

    function householdWatcher(memberId, householdId) {
      return memberInHousehold(memberId, householdId)
        && get(/databases/$(database)/documents/users/$(memberId)).data.get('role', 'watcher') != 'viewer';
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        isSelf(userId) ||
        resource.data.householdId == userHousehold()
      );
      allow create, update: if isSelf(userId);
    }

    match /households/{householdId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 1;
      allow update: if inHousehold(householdId) || isJoiningHousehold();

      match /availability/{docId} {
        allow read: if inHousehold(householdId);
        allow create: if isWatcher(householdId)
          && docId == request.resource.data.date + '_' + request.resource.data.userId
          && request.resource.data.date is string
          && householdWatcher(request.resource.data.userId, householdId);
        allow update: if isWatcher(householdId)
          && docId == resource.data.date + '_' + resource.data.userId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.date == resource.data.date;
        allow delete: if isWatcher(householdId)
          && docId == resource.data.date + '_' + request.auth.uid
          && resource.data.userId == request.auth.uid;
      }

      match /schedules/{date} {
        allow read: if inHousehold(householdId);
        allow create, update: if isWatcher(householdId);
        allow delete: if false;
      }
    }
  }
}
