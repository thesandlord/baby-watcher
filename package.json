{
  "name": "baby-watcher",
  "private": true,
  "workspaces": [
    "shared",
    "web"
  ],
  "scripts": {
    "test": "npm run test --workspace=shared",
    "build": "npm run build --workspace=shared && npm run build --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "dev:emulators": "firebase emulators:start --only firestore,auth --project demo-baby-watcher",
    "dev:local": "bash scripts/prepare-local-env.sh && concurrently -k -n emulators,web -c blue,green \"npm run dev:emulators\" \"npm run dev --workspace=web\"",
    "seed:demo": "FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/seed-emulator-demo.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "firebase-tools": "^13.30.0"
  },
  "engines": {
    "node": ">=20"
  }
}
