# Local emulator config (copy to web/.env.local)
# Firebase demo project values work with the Auth + Firestore emulators.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-baby-watcher.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-baby-watcher
VITE_FIREBASE_STORAGE_BUCKET=demo-baby-watcher.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:demo

# Emulator mode
VITE_USE_FIREBASE_EMULATORS=true

# Mock calendar extraction locally (no OpenRouter key required)
VITE_MOCK_CALENDAR_EXTRACTION=true

# Optional: real OpenRouter key for testing live extraction
# VITE_OPENROUTER_API_KEY=
# VITE_OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
